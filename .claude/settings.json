{
  "permissions": {
    "allow": [
      "Bash(node --check *)",
      "Bash(git rev-list *)",
      "Bash(git fetch *)",
      "Bash(curl -s -o /dev/null *)",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "Bash(node scripts/*)",
      "Bash(node .claude/gsd-core/bin/gsd-tools.cjs *)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin claude/*)",
      "Bash(git rev-parse *)",
      "Bash(pkill -f remote-debugging-port*)",
      "Bash(pkill -f http.server*)",
      "Bash(curl -s https://playpastrypirates.com/*)",
      "Bash(curl -s https://staging.playpastrypirates.com/*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.secrets)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Cloud QA browser setup (no-op on the laptop)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-base.cjs\"",
            "timeout": 15,
            "statusMessage": "Marking where this session started"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wyclau-pulse.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Stamping that a session is alive in this tree"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/glass-harvest-first.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Harvest his words off the Glass before republishing over them"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wyclau-pulse.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Stamping that a session is alive in this tree"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cto-staging-only.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "CTO lock held? then main is unreachable"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-the-doc-first.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking CLAUDE.md \u00a74 \u2014 read the doc first"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/qa-gear-first.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Which QA gear is this change in? (docs/QA-PROCESS.md)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ceo-cadence-fence.cjs\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/playtest-checklist-last.cjs\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Did this session change the game? Wyatt needs a checklist"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/org/hooks/no-idle-offer.cjs\"",
            "timeout": 10,
            "statusMessage": "Does this turn end on an offer? An offer ends the run"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wyclau-stop-keep-working.cjs\" || true",
            "timeout": 10,
            "statusMessage": "Is there unblocked Chart work, a preemption, or a stale Glass pulse?"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/org/hooks/no-idle-offer.cjs\"",
            "timeout": 10,
            "statusMessage": "Does this turn end on an offer? An offer ends the run"
          }
        ]
      }
    ]
  }
}
