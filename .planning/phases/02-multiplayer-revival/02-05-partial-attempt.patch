@@ -1032,6 +1032,49 @@ export function appendChatLine(seat,text){
   line.innerHTML=`${pn(seat)}: ${escHtml(text)}`;
   log.appendChild(line);
   log.scrollTop=log.scrollHeight;
+  // D-06/D-07 (02-05): watchChat's only consumer already routes every incoming message (including
+  // this client's own) through appendChatLine — the flash and the unread mark hang off this SAME
+  // call rather than a second listener, so orchestrator.js needs no edit (key_links, 02-05-PLAN.md).
+  if(seat===appState.mySeat)return;                        // never flash your own sent message back
+  if(document.body.classList.contains("pp4Chat"))return;   // sheet open — already visible, no flash/dot
+  showChatFlash(seat,text);
+  setChatUnread(true);
+}
+let chatFlashRevealT=null,chatFlashHideT=null;
+// D-07: the flash under the ribbon. No typewriter reveal (unlike showChatBubble below) — D-06 is
+// deliberately the smallest honest version and a per-character reveal on a second surface is new
+// design work nothing asked for; the flash simply appears, holds, and fades. `pn()`/`escHtml()` are
+// the exact route appendChatLine already uses — no second escaping path.
+export function showChatFlash(seat,text){
+  const el=$("pp4ChatFlash");if(!el)return;
+  clearTimeout(chatFlashRevealT);clearTimeout(chatFlashHideT);
+  el.classList.remove("out");
+  el.innerHTML=`${pn(seat)}: ${escHtml(text)}`;
+  el.style.display="block";
+  // D-15's own chat-bubble hold curve (chatBubbleHoldMs, util.js — CHAT_BUBBLE_HOLD_MULTIPLIER,
+  // fc68f74/util.js:1419), reused as-is rather than a hand-typed duration: it is already the
+  // codebase's answer to "how long does this chat message hold before it fades," and a ribbon-
+  // anchored flash of the same message has no reason to disagree with the bubble's own reading of
+  // the same text.
+  chatFlashRevealT=setTimeout(()=>{
+    el.classList.add("out");
+    // 350ms matches .pp4Bub's own `transition:opacity .35s` (index.html) — the fade-out timing this
+    // codebase already uses for a floating message card, not a new number.
+    chatFlashHideT=setTimeout(()=>{ if(el.classList.contains("out"))el.style.display="none"; },350);
+  },chatBubbleHoldMs(text));
+}
+// T-02-15: one flash element, replaced by the newest message rather than stacked, plus instant
+// tap-dismissal at any lifecycle stage — the same DoS mitigation showChatBubble's own onclick gives
+// a bubble, and the same reason: a captain spamming chat must not be able to wall off the ribbon.
+export function hideChatFlash(){
+  const el=$("pp4ChatFlash");if(!el)return;
+  clearTimeout(chatFlashRevealT);clearTimeout(chatFlashHideT);
+  el.classList.add("out");
+  el.style.display="none";
+}
+export function setChatUnread(v){
+  const dot=$("pp4ChatDot");if(!dot)return;
+  dot.style.display=v?"block":"none";
 }
